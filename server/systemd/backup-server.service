[Unit]
Description=Backup Center - serveur de sauvegarde
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backup-server
Group=backup-server
ExecStart=/opt/backup-server/backup-server
Restart=on-failure
RestartSec=3
Environment=BACKUP_SERVER_DATA_DIR=/var/lib/backup-server
Environment=BACKUP_SERVER_HOST=0.0.0.0
Environment=BACKUP_SERVER_PORT=8420

# Hardening. ReadWritePaths covers both the SQLite database directory and
# wherever the operator points the NAS storage path from the settings
# panel; if that path lives outside /var/lib/backup-server, add it here too.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/backup-server
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
