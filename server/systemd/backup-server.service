[Unit]
Description=Backup Center - serveur de sauvegarde
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backup-server
Group=backup-server
ExecStart=/opt/backup-server/backup-server
Restart=on-failure
RestartSec=3
Environment=BACKUP_SERVER_DATA_DIR=/var/lib/backup-server
Environment=BACKUP_SERVER_HOST=0.0.0.0
# Admin panel (dashboard, settings, device management): keep this on a
# port you can firewall to an admin-only network/VLAN.
Environment=BACKUP_SERVER_PANEL_PORT=80
# Agent traffic (enrollment, backups, WebSocket): must stay reachable from
# every VLAN/subnet a backed-up workstation lives on.
Environment=BACKUP_SERVER_AGENT_PORT=8420

# Hardening. ReadWritePaths covers both the SQLite database directory and
# wherever the operator points the NAS storage path from the settings
# panel; if that path lives outside /var/lib/backup-server, add it here too.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/backup-server
LimitNOFILE=65536

# Lets the backup-server user bind the panel's port 80 without running as
# root - systemd grants this single capability directly to the process at
# start, compatible with NoNewPrivileges above.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
